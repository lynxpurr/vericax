# evaluation outputs are per-run, never committed
results/
cache/
download/

# VM images and archives stay out of git (manifest + checksums only)
*.qcow2
*.qcow2.zst
*.iso

# local envs
.venv/
venv/
__pycache__/
*.pyc

# secrets
.env
*.key

# machine-local paths to external assets
vericax.toml

# episode outputs (harness) are per-run, never committed
runs/
containers/agent/context/

# derived validity records (regenerated by `vericax audit`)
reference_selfcheck.json
