{
  "tools": {
    "deny": ["group:fs", "browser", "web"]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "DEEPSEEK_API_KEY"
        },
        "models": [
          {
            "id": "deepseek-flash",
            "name": "DeepSeek V4.1 Flash"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": "deepseek/deepseek-flash"
    }
  }
}