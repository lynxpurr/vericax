#!/usr/bin/env python3
"""Re-exec the vericax CLI under the runtime venv when one is configured.

VM-capable commands need the runtime venv (it carries docker, requests and the
engiworld runtime package). This wrapper resolves the runtime from
vericax.toml / VERICAX_RUNTIME and re-execs itself with that interpreter.
"""
import os
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]


def _venv_python() -> str | None:
    raw = os.environ.get("VERICAX_RUNTIME")
    if not raw:
        try:
            import tomllib
            with (REPO / "vericax.toml").open("rb") as fh:
                raw = tomllib.load(fh).get("runtime", {}).get("path")
        except (OSError, ValueError, ModuleNotFoundError):
            raw = None
    if not raw:
        return None
    candidate = Path(raw).expanduser() / ".venv" / "bin" / "python"
    return str(candidate) if candidate.is_file() else None


def main() -> int:
    venv_python = _venv_python()
    env = dict(os.environ)
    env["PYTHONPATH"] = str(REPO) + os.pathsep + env.get("PYTHONPATH", "")
    env.setdefault("PYTHONUNBUFFERED", "1")
    if venv_python and os.path.realpath(venv_python) != os.path.realpath(sys.executable):
        os.execv(venv_python, [venv_python, "-u", "-m", "vericax", *sys.argv[1:]])
    from vericax.cli import main as cli_main
    return cli_main(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
